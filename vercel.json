{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "NODE_ENV=development npm install --include=dev",
  "buildCommand": "npm run build -w client",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
