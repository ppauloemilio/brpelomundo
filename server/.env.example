# Banco Postgres no Neon (obrigatório).
# Pegue em console.neon.tech > seu projeto > Connection string (pooled).
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.região.aws.neon.tech/brpelomundo?sslmode=require

# Em rede corporativa com inspeção de TLS, o Node rejeita o certificado do Neon
# (SELF_SIGNED_CERT_IN_CHAIN). Rode os comandos locais com a CA do Windows:
#   $env:NODE_OPTIONS="--use-system-ca"
# Não é necessário na Vercel.

# Armazenamento de imagens no Vercel Blob.
# Sem esta variável, os uploads caem na pasta local server/uploads (só serve para dev).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# URL do frontend (usado nos links de convite por e-mail + CORS)
APP_URL=http://localhost:5173

# Origens extras do front (opcional, separadas por vírgula). Ex. preview da Vercel
# CORS_ORIGIN=https://brpelomundo.vercel.app,https://brpelomundo-git-main.vercel.app

# SMTP para envio de e-mails (ex.: Outlook/Hotmail, Gmail, SendGrid)
# Sem estas variáveis, o link de convite aparece no console do servidor.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=seu-email@hotmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=Comunidade Brasil <noreply@comunidadebr.app>

JWT_SECRET=altere-em-producao

# Mercado Pago PIX (recomendado — BRL). Se configurado, tem prioridade sobre PayPal.
# Use o Access Token (APP_USR-... produção ou TEST-... teste), NÃO a Public Key.
# Pode reutilizar o mesmo token do BuscaZapp.
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# Em token TEST-, opcional: e-mail do comprador de teste do Mercado Pago
# MERCADOPAGO_TEST_PAYER_EMAIL=test_user_xxx@testuser.com
# APP_URL deve ser a URL pública (Vercel) para o webhook PIX funcionar.

# PayPal (opcional / legado). Só entra se Mercado Pago NÃO estiver configurado.
# PAYPAL_CLIENT_ID=seu_client_id
# PAYPAL_CLIENT_SECRET=seu_secret
# PAYPAL_MODE=sandbox
# PAYPAL_ALLOW_DEMO=1

